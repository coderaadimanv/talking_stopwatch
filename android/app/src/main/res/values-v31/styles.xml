<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 draws the splash itself, from the launcher icon on this
         colour, and ignores windowBackground for it. Same ink, said the way
         this version listens for. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
    </style>
</resources>
