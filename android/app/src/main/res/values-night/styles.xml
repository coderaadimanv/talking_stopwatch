<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Both the day and the night file say the same thing, and that is the
         point: the app has one theme and it is dark, so the window behind it
         must not follow the system's light setting. -->

    <!-- While the process starts, before Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter UI for the rest of the session. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
